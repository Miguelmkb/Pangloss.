# Copia este archivo a .env.local y rellena los valores desde
# Supabase Dashboard → Project Settings → API.
# .env.local nunca se sube a git (ya está en .gitignore).

# Project URL (pública, segura de exponer en el cliente)
VITE_SUPABASE_URL=

# anon / public key (pública, segura de exponer en el cliente — la seguridad
# real la dan las políticas RLS, no el secreto de esta clave)
VITE_SUPABASE_ANON_KEY=

# NUNCA pongas la service_role key aquí ni en ningún archivo VITE_*.
# Esa clave se usa solo en funciones serverless (Netlify Functions) y vive
# como variable de entorno del propio Netlify, nunca en el bundle del cliente.

# ---------------------------------------------------------------------------
# Variables de servidor (netlify/functions/) — van en un archivo `.env`
# aparte (no este, no .env.local), y en Netlify → Environment variables al
# desplegar. Nunca con prefijo VITE_.

# Resend (envío de emails de suscripción). Dashboard → API Keys.
RESEND_API_KEY=

# Remitente. Opcional mientras no haya dominio verificado en Resend — sin
# esto, se usa su remitente de pruebas por defecto.
RESEND_FROM_EMAIL=

# Supabase → Project Settings → API → service_role (secreta, nunca la anon).
# La necesita notify-subscribers.ts para leer la lista de suscriptores
# saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY=
